// Prisma schema — Supabase Postgres
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CheckEventStatus {
  draft
  open
  closed
}

enum CheckMemberStatus {
  pending
  approved
  cancelled
}

enum BehaviorReportStatus {
  pending
  approved
  cancelled
}

model Member {
  id                String             @id @default(cuid())
  name              String
  age               Int
  facebookUrl       String?            @map("facebook_url")
  isLive            Boolean            @default(true) @map("is_live")
  groupId           String?            @map("group_id")
  createBy          String             @map("create_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  group             Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  players           Player[]
  behaviors         Behavior[]
  checkEventMembers CheckEventMember[]
  behaviorReports   BehaviorReport[]
  safes             Safe[]
  appUser           AppUser?

  @@index([name])
  @@index([isLive])
  @@index([isLive, name])
  @@index([groupId])
  @@index([createdAt])
  @@map("members")
}

model Group {
  id        String   @id @default(cuid())
  groupName String   @map("group_name")
  isUse     Boolean  @default(true) @map("is_use")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  members   Member[]

  @@index([groupName])
  @@index([isUse])
  @@map("groups")
}

model Player {
  id              String           @id @default(cuid())
  name            String
  memberId        String           @map("member_id")
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createBy        String           @map("create_by")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  behaviors       Behavior[]
  behaviorReports BehaviorReport[]
  teamAssignments TeamAssignment[]

  @@index([memberId])
  @@index([name])
  @@index([createdAt])
  @@map("players")
}

model Behavior {
  id           String          @id @default(cuid())
  description  String
  evidenceUrl  String?         @map("evidence_url")
  createBy     String          @map("create_by")
  memberId     String          @map("member_id")
  playerId     String          @map("player_id")
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player       Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  sourceReport BehaviorReport?

  @@index([memberId])
  @@index([playerId])
  @@index([description])
  @@index([createdAt])
  @@map("behaviors")
}

model BehaviorReport {
  id             String               @id @default(cuid())
  memberId       String               @map("member_id")
  playerId       String               @map("player_id")
  message        String
  evidenceUrl    String?              @map("evidence_url")
  status         BehaviorReportStatus @default(pending)
  memberNameSnap String               @map("member_name_snap")
  playerNameSnap String               @map("player_name_snap")
  decidedBy      String?              @map("decided_by")
  decidedAt      DateTime?            @map("decided_at")
  decisionNote   String?              @map("decision_note")
  behaviorId     String?              @unique @map("behavior_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  member         Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  player         Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  behavior       Behavior?            @relation(fields: [behaviorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([memberId])
  @@index([playerId])
  @@index([createdAt])
  @@map("behavior_reports")
}

model SetDate {
  id          String       @id @default(cuid())
  date        DateTime     @db.Date
  createBy    String       @map("create_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  checkEvents CheckEvent[]

  @@index([date])
  @@map("set_dates")
}

model CheckEvent {
  id        String             @id @default(cuid())
  setDateId String             @map("set_date_id")
  setDate   SetDate            @relation(fields: [setDateId], references: [id], onDelete: Restrict)
  title     String?
  status    CheckEventStatus   @default(draft)
  createBy  String             @map("create_by")
  openedAt  DateTime?          @map("opened_at")
  closedAt  DateTime?          @map("closed_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  members   CheckEventMember[]

  @@index([setDateId])
  @@index([status])
  @@index([createdAt])
  @@map("check_events")
}

model CheckEventMember {
  id                 String            @id @default(cuid())
  checkEventId       String            @map("check_event_id")
  memberId           String            @map("member_id")
  memberNameSnapshot String            @map("member_name_snapshot")
  status             CheckMemberStatus @default(pending)
  decidedBy          String?           @map("decided_by")
  decidedAt          DateTime?         @map("decided_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  checkEvent         CheckEvent        @relation(fields: [checkEventId], references: [id], onDelete: Cascade)
  member             Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([checkEventId, memberId])
  @@index([checkEventId])
  @@index([memberId])
  @@index([status])
  @@map("check_event_members")
}

model Item {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  safes     Safe[]

  @@index([name])
  @@map("items")
}

model Safe {
  id            String   @id @default(cuid())
  itemId        String   @map("item_id")
  quantity      Int
  description   String?
  depositItemAt DateTime @map("deposit_item_at")
  memberId      String   @map("member_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@index([memberId])
  @@index([depositItemAt])
  @@map("safes")
}

enum AppUserRole {
  admin
  user
}

enum TypeServerKind {
  official
  premium
}

/// App profile for a Supabase Auth user. `id` is the auth user id.
model AppUser {
  id         String      @id
  email      String      @unique
  role       AppUserRole @default(user)
  isUse      Boolean     @default(true) @map("is_use")
  memberId   String?     @unique @map("member_id")
  lastSeenAt DateTime    @default(now()) @map("last_seen_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  member     Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([isUse])
  @@map("users")
}

model Server {
  id         String  @id @default(cuid())
  serverName String  @map("server_name")
  isUse      Boolean @default(true) @map("is_use")
  bosses     Boss[]

  @@index([serverName])
  @@index([isUse])
  @@map("servers")
}

model TypeServer {
  id     String         @id @default(cuid())
  type   TypeServerKind
  isUse  Boolean        @default(true) @map("is_use")
  bosses Boss[]

  @@index([type])
  @@index([isUse])
  @@map("type_servers")
}

model City {
  id       String  @id @default(cuid())
  cityName String  @map("city_name")
  isUse    Boolean @default(true) @map("is_use")
  bosses   Boss[]

  @@index([cityName])
  @@index([isUse])
  @@map("cities")
}

model Boss {
  id           String     @id @default(cuid())
  cityId       String     @map("city_id")
  serverId     String     @map("server_id")
  typeServerId String     @map("type_server_id")
  hour         Int
  minute       Int
  second       Int        @default(0) @map("clock_second")
  /// Manual column. Null follows the clock.
  boardLane    String?    @map("board_lane")
  createBy     String     @map("create_by")
  updateBy     String?    @map("update_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  city         City       @relation(fields: [cityId], references: [id], onDelete: Restrict)
  server       Server     @relation(fields: [serverId], references: [id], onDelete: Restrict)
  typeServer   TypeServer @relation(fields: [typeServerId], references: [id], onDelete: Restrict)

  @@unique([cityId, serverId, typeServerId])
  @@index([cityId])
  @@index([serverId])
  @@index([typeServerId])
  @@index([createdAt])
  @@map("bosses")
}

enum TeamSlotType {
  waiting
  main
  reserve
  inactive
}

enum TeamSessionStatus {
  draft
  active
  completed
}

model Team {
  id           String   @id @default(cuid())
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  isUse        Boolean  @default(true) @map("is_use")
  mainLimit    Int      @default(5) @map("main_limit")
  reserveLimit Int      @default(3) @map("reserve_limit")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignments TeamAssignment[]

  @@index([isUse])
  @@index([sortOrder])
  @@map("teams")
}

model TeamSession {
  id        String            @id @default(cuid())
  title     String?
  status    TeamSessionStatus @default(draft)
  createBy  String            @map("create_by")
  startedAt DateTime?         @map("started_at")
  endedAt   DateTime?         @map("ended_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  assignments TeamAssignment[]

  @@index([status])
  @@index([createdAt])
  @@map("team_sessions")
}

model TeamAssignment {
  id        String       @id @default(cuid())
  sessionId String       @map("session_id")
  playerId  String       @map("player_id")
  teamId    String?      @map("team_id")
  slotType  TeamSlotType @default(waiting) @map("slot_type")
  sortOrder Int          @default(0) @map("sort_order")

  session TeamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  team    Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createBy  String   @map("create_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, playerId])
  @@index([sessionId])
  @@index([playerId])
  @@index([teamId])
  @@index([slotType])
  @@index([sessionId, teamId, slotType, sortOrder])
  @@map("team_assignments")
}
