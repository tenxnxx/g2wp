# Copy to .env.local and fill real values. Never commit real secrets.

# Prisma — pooler for the app, direct for migrate CLI
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth (anon / publishable only — never put service_role in the app)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=optional_publishable_key

# Comma-separated admin emails (required in production).
# Also accepted: Supabase user app_metadata.role = "admin"
ADMIN_EMAILS=admin@example.com

# Optional: force allowlist even in development (1 = fail closed when empty)
# REQUIRE_ADMIN_ALLOWLIST=1

# Optional: shared rate limit across Netlify instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token
