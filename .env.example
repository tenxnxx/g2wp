# Copy to .env.local and fill real values. Never commit real secrets.

# Local Docker Postgres: npm run db:up
# App and Prisma migrate both use this direct connection (no pooler).
DATABASE_URL=postgresql://g2wp:g2wp@localhost:5433/g2wp
# Connections opened by one Node process. Keep this small when several instances share one database.
# DATABASE_POOL_MAX=5
DIRECT_URL=postgresql://g2wp:g2wp@localhost:5433/g2wp

# Remote Supabase Postgres (production / Netlify) — pooler for the app, session for migrate
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth. Anon key is public. Service role stays server-only (never NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=optional_publishable_key
# Required to create users with the email already confirmed.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bootstrap admins. These emails are always admins, even before a users row exists.
# Other accounts are stored in `users` on first sign-in and can be promoted there.
ADMIN_EMAILS=test@gmail.com

# Optional: shared cache and rate limit. Redis protocol URL, server-only.
# REDIS_URL=redis://default:password@host:6379

# Optional: shared rate limit across Netlify instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# Boss spawned alerts. Server-only. Discord can be added later as another channel.
# TELEGRAM_BOT_TOKEN=123456:your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
